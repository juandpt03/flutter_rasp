<?xml version="1.0" encoding="utf-8"?>
<!--
  EXAMPLE APP ONLY. Allows cleartext traffic to the local mock
  backend regardless of host (emulator alias, localhost, LAN IP).
  Do not copy this file into a production app — flutter_rasp
  assumes HTTPS for real backends.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
